rules_version = '2';

// Regras do app do corredor (Ritmex). A página pode ser alterada por qualquer pessoa,
// então TODA permissão de verdade mora aqui. Publique com:  firebase deploy --only firestore
//
// Administradores: crie à mão, no console do Firestore, o documento  config/admins  com o campo
//   emails (array) = ["seu-email@gmail.com", "email-do-diego@gmail.com"]
// Ninguém consegue alterar esse documento pelo app.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() { return request.auth != null; }
    function eu() { return request.auth.uid; }
    function admin() {
      return logado()
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/config/admins)
        && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails;
    }
    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function textoOpcional(v, max) { return v == null || (v is string && v.size() <= max); }
    function regiao(v) { return v in ['zona sul', 'zona norte', 'zona leste', 'zona oeste', 'centro']; }
    function dataISO(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function soCampos(campos) { return request.resource.data.keys().hasOnly(campos); }
    // Momento gravado pela página (ISO, ex.: 2026-10-22T11:15:34.833Z). Texto em outro formato quebraria o feed.
    function momento(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,3})?Z$'); }
    // A data (AAAA-MM-DD) já chegou (meia-noite UTC; a prova pode ser concluída a partir do dia dela).
    function dataJaChegou(data) {
      let p = data.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2])) <= request.time;
    }

    // Só admin lê: a lista de e-mails dos administradores não fica exposta aos corredores.
    match /config/{doc} {
      allow read: if admin();
      allow write: if false;
    }

    // Provas e parceiros: qualquer um lê; só admin escreve (importação do coletor, destaque).
    match /provas/{id} {
      allow read: if true;
      allow write: if admin();
    }
    match /parceiros/{id} {
      allow read: if true;
      allow write: if admin();
    }

    // Chaves do Strava: SÓ a própria pessoa lê e escreve (acordo de API do Strava: os dados do atleta
    // são só para ele). Não há atividades aqui; elas são lidas do Strava na hora e não ficam guardadas.
    match /strava/{uid} {
      allow read, delete: if logado() && uid == eu();
      allow create, update: if logado() && uid == eu()
        && soCampos(['atletaId', 'nome', 'foto', 'escopo', 'accessToken', 'refreshToken', 'expiraEm', 'conectadoEm'])
        && texto(request.resource.data.accessToken, 10, 200)
        && texto(request.resource.data.refreshToken, 10, 200)
        && request.resource.data.expiraEm is number
        && textoOpcional(request.resource.data.nome, 120)
        && textoOpcional(request.resource.data.foto, 500)
        && textoOpcional(request.resource.data.escopo, 200);
    }

    // Perfil: cada um escreve só o seu. Logados podem ler (é o que faz a parte social funcionar).
    match /usuarios/{uid} {
      allow read: if logado();
      allow create, update: if logado() && uid == eu()
        && soCampos(['nome', 'handle', 'cidade', 'regiao', 'zonas', 'instagram', 'distancias', 'nomeBusca', 'foto', 'atualizadoEm'])
        // zonas favoritas de treino (opcional): até 5
        && (!('zonas' in request.resource.data) || (request.resource.data.zonas is list && request.resource.data.zonas.size() <= 5))
        && texto(request.resource.data.nome, 2, 60)
        && request.resource.data.handle is string && request.resource.data.handle.matches('^[a-z0-9_.]{3,20}$')
        && texto(request.resource.data.cidade, 2, 60)
        // zona só em São Paulo; nas outras cidades fica vazia
        && (regiao(request.resource.data.regiao) || request.resource.data.regiao == '')
        && textoOpcional(request.resource.data.instagram, 30)
        && request.resource.data.distancias is list && request.resource.data.distancias.size() <= 4
        && texto(request.resource.data.nomeBusca, 1, 80)
        && textoOpcional(request.resource.data.foto, 500);
      allow delete: if logado() && uid == eu();
    }

    // "Vou correr": o id é <provaId>_<uid>, então cada pessoa confirma uma vez por prova.
    match /confirmacoes/{id} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.uid == eu()
        && id == request.resource.data.provaId + '_' + eu()
        && exists(/databases/$(database)/documents/provas/$(request.resource.data.provaId))
        && soCampos(['provaId', 'uid', 'nome', 'data', 'em'])
        && texto(request.resource.data.nome, 1, 60)
        && dataISO(request.resource.data.data)
        && momento(request.resource.data.em);
      allow delete: if logado() && resource.data.uid == eu();
    }

    // Seguir: o id é <seguidor>_<alvo>.
    match /follows/{id} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.seguidor == eu()
        && request.resource.data.alvo != eu()
        && id == eu() + '_' + request.resource.data.alvo
        && soCampos(['seguidor', 'alvo', 'em'])
        && momento(request.resource.data.em);
      // quem segue desfaz; quem é seguido também pode remover (exclusão da conta, LGPD)
      allow delete: if logado() && (resource.data.seguidor == eu() || resource.data.alvo == eu());
    }

    // "Concluí esta prova": o id é <provaId>_<uid>. Aparece no feed, no ranking dos grupos e nas medalhas
    // (é a chegada numa prova pública, não um treino). Só o dono cria e apaga. Para ninguém inventar
    // prova, distância ou tempo: a prova precisa existir e já ter acontecido, a pessoa precisa ter
    // confirmado presença, o nome e a data são os da prova, a distância vai até a maior da prova
    // (kmMax, gravado na importação; +1 km de folga) e o ritmo não passa de 2:00/km.
    function conclusaoValida(id) {
      let c = request.resource.data;
      // get() de prova que não existe dá erro, e erro nas regras = acesso negado.
      let prova = get(/databases/$(database)/documents/provas/$(c.provaId)).data;
      let kmMax = prova.get('kmMax', null);
      return c.uid == eu()
        && id == c.provaId + '_' + eu()
        && soCampos(['provaId', 'provaNome', 'data', 'distanciaKm', 'tempoSeg', 'uid', 'nome', 'em'])
        && exists(/databases/$(database)/documents/confirmacoes/$(id))
        && c.provaNome == prova.nome
        && c.data == prova.data
        && dataISO(c.data) && dataJaChegou(c.data)
        && texto(c.nome, 1, 60)
        && momento(c.em)
        && c.distanciaKm is number && c.distanciaKm > 0
        && c.distanciaKm <= ((kmMax is number) ? kmMax + 1 : 250)
        && (c.tempoSeg == null || (c.tempoSeg is int && c.tempoSeg > 60 && c.tempoSeg < 86400 && c.tempoSeg >= c.distanciaKm * 120));
    }
    match /conclusoes/{id} {
      allow read: if logado();
      allow create, update: if logado() && conclusaoValida(id);
      allow delete: if logado() && resource.data.uid == eu();
    }

    // Treinos: PRIVADOS. Só o dono lê, cria e apaga (não entram no feed nem no ranking). Distância de 0 a 300 km,
    // ritmo até 2:00/km (minutos >= 2 x km).
    match /treinos/{id} {
      allow read: if logado() && resource.data.uid == eu();
      allow create: if logado()
        && request.resource.data.uid == eu()
        && soCampos(['uid', 'nome', 'data', 'km', 'minutos', 'descricao', 'origem', 'em'])
        && request.resource.data.km is number && request.resource.data.km > 0 && request.resource.data.km <= 300
        && dataISO(request.resource.data.data)
        && (request.resource.data.minutos == null || (request.resource.data.minutos is int && request.resource.data.minutos > 0 && request.resource.data.minutos <= 2000
          && request.resource.data.minutos >= request.resource.data.km * 2))
        && textoOpcional(request.resource.data.descricao, 120)
        && request.resource.data.origem in ['manual', 'gpx']
        && momento(request.resource.data.em);
      allow delete: if logado() && resource.data.uid == eu();
    }

    // Grupos: o id do documento É o código do convite (6 letras/números). Por isso só entra quem sabe o
    // código: dá para ler um grupo pelo id (get), mas listar/buscar (list) só devolve os grupos em que
    // você é membro. O dono cria (só ele de membro) e apaga. Quem tem o código pode ENTRAR (acrescentar
    // só a si mesmo) e qualquer membro pode SAIR (tirar só a si mesmo).
    // Grupos criados antes desta regra têm id aleatório: os membros continuam, mas ninguém novo entra.
    match /grupos/{id} {
      allow get: if logado();
      allow list: if logado() && eu() in resource.data.membros;
      allow create: if logado()
        && id == request.resource.data.codigo
        && request.resource.data.dono == eu()
        && request.resource.data.membros == [eu()]
        && soCampos(['nome', 'codigo', 'dono', 'membros', 'criadoEm'])
        && texto(request.resource.data.nome, 3, 40)
        && request.resource.data.codigo is string && request.resource.data.codigo.matches('^[A-Z0-9]{6}$');
      allow update: if logado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['membros'])
        && request.resource.data.membros.size() <= 30
        && (
          // entrar
          (!(eu() in resource.data.membros)
            && request.resource.data.membros.toSet() == resource.data.membros.toSet().union([eu()].toSet()))
          ||
          // sair (o dono não sai: ele apaga o grupo)
          (eu() in resource.data.membros && resource.data.dono != eu()
            && request.resource.data.membros.toSet() == resource.data.membros.toSet().difference([eu()].toSet()))
        );
      allow delete: if logado() && resource.data.dono == eu();
    }
  }
}
