# ============================================================
#  Corrida X (coletor) — configuração
#  Copie este arquivo para ".env" e preencha. O ".env" tem a sua
#  chave secreta: nunca envie para o GitHub nem cole em conversas.
# ============================================================

# --- AIsa (https://aisa.one) — a mesma conta/chave do Prospector ---
# Uma única chave serve para a busca no Google (via DataForSEO) e para o LLM.
AISA_API_KEY=cole-sua-chave-aqui
AISA_BASE_URL=https://api.aisa.one
# Modelo que lê os resultados e extrai as provas (https://aisa.one/docs/guides/models)
AISA_MODEL=gpt-4.1-mini

# --- Onde e o que buscar ---------------------------------------
CITY_NAME=São Paulo
# Local da busca no Google, no formato do DataForSEO (em inglês, sem acento)
SEARCH_LOCATION=Sao Paulo,State of Sao Paulo,Brazil
SEARCH_LANGUAGE=pt
# Resultados do Google por consulta. Quanto maior, mais caro (máx. 200).
SEARCH_DEPTH=20
# Regiões pesquisadas quando você não usa --regiao (separe por vírgula):
# zona sul, zona norte, zona leste, zona oeste, centro
REGIONS=zona sul
# Quantas semanas à frente entram no calendário (o piloto pede 8)
WINDOW_WEEKS=8

# --- Saída ---------------------------------------------------
OUTPUT_DIR=output

# ============================================================
#  APP WEB (python -m webapp) — só necessário se for usar a versão web
# ============================================================

# "firebase" = exige login (use SEMPRE que o app estiver na internet).
# "none"     = sem login; o servidor só aceita conexões do próprio computador.
AUTH_MODE=firebase

# Login: o mesmo Firebase do app de pesquisa/Prospector (arquivo
# pesquisademercado/js/firebase-config.js). Não são segredos.
FIREBASE_PROJECT_ID=seu-projeto-firebase
FIREBASE_WEB_API_KEY=cole-o-apiKey-do-firebase-config
FIREBASE_APP_ID=cole-o-appId-do-firebase-config

# E-mails que podem usar o app, separados por vírgula. Sem esta lista o servidor não sobe.
ALLOWED_EMAILS=voce@exemplo.com,diego@exemplo.com

# Limites de custo
MAX_QUERIES=12
MAX_DEPTH=50

HOST=127.0.0.1
PORT=8000
